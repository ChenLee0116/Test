{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run RazorPagesHelloWorld",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"RazorPagesHelloWorld/RazorPagesHelloWorld.csproj",
				"--no-launch-profile",
				"--urls",
				"http://0.0.0.0:5016"
			],
			"options": {
				"env": {
					"ASPNETCORE_ENVIRONMENT": "Development"
				}
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}